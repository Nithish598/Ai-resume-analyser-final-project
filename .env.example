# ============================================================
# AI Recruitment Platform — LLM Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# LLM Provider: "gemini" (default) or "openai"
LLM_PROVIDER=gemini

# API Key for the chosen provider
# For Gemini: https://aistudio.google.com/app/apikey
# For OpenAI: https://platform.openai.com/api-keys
LLM_API_KEY=your-api-key-here

# Model to use for the primary extraction pass
# Gemini options: gemini-3.5-flash-lite, gemini-3.5-flash, gemini-3.6-flash, gemini-3.7-flash
# OpenAI options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
LLM_MODEL=gemini-3.5-flash-lite

# Model to use for the validation (Pass 2) — can be same or different
LLM_VALIDATION_MODEL=gemini-3.5-flash

# Automatic Gemini model fallback configuration (comma-separated fallback models in priority order)
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Set to "false" to disable LLM and use deterministic extraction only
LLM_ENABLED=true

# Maximum tokens for LLM response
LLM_MAX_OUTPUT_TOKENS=8192

# Request timeout in seconds
LLM_TIMEOUT_SECONDS=30
