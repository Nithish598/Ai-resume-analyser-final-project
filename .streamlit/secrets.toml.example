# ============================================================
# Streamlit Community Cloud Secrets Template
# ============================================================
# To configure on Streamlit Community Cloud:
# 1. Go to share.streamlit.io and navigate to your deployed app.
# 2. Click the 3 dots (⋮) -> "Settings" -> "Secrets".
# 3. Paste the contents below with your actual API key and click "Save".
# ============================================================

LLM_PROVIDER = "gemini"
LLM_MODEL = "gemini-3.5-flash-lite"
LLM_VALIDATION_MODEL = "gemini-3.5-flash-lite"
LLM_ENABLED = "true"
GEMINI_API_KEY = "your-gemini-api-key-here"
LLM_API_KEY = "your-gemini-api-key-here"

# (Optional) If using OpenAI instead:
# LLM_PROVIDER = "openai"
# LLM_MODEL = "gpt-4o-mini"
# OPENAI_API_KEY = "your-openai-api-key-here"
